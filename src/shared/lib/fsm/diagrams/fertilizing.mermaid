stateDiagram-v2
    [*] --> IDLE
    state canApply <<choice>>
    IDLE --> canApply: START_FERTILIZE (viewerId, fertilizers, crops)
    canApply --> CROP_SELECTION: canFertilize($fertilizers, $crops)
    canApply --> IDLE
    CROP_SELECTION --> FERTILIZED: CHOOSE_CROP (bedIndex)
    FERTILIZED --> FERTILIZED: CHOOSE_CROP (bedIndex)
    CROP_SELECTION --> IDLE: END_FERTILIZE
    FERTILIZED --> IDLE: END_FERTILIZE

note right of IDLE
+Init
end note

note right of [*]
define/canFertilize (f,c) => and(isPositive(coalesce(f,0)), isPositive(len(coalesce(c,[]))))
#{viewerId = 0, bedIndex = -1, seq = 0}
subscribe/fertilize_phase_started START_FERTILIZE ($viewerId, $fertilizers, $crops)
subscribe/fertilize_crop_picked CHOOSE_CROP ($bedIndex)
subscribe/turn_phase_ended END_FERTILIZE
subscribe/turn_ended END_FERTILIZE
end note

note left of CROP_SELECTION
#{viewerId, bedIndex, seq} <= coalesce($viewerId, #viewerId), -1, #seq
end note

note right of FERTILIZED
#{viewerId, bedIndex, seq} <= #viewerId, $bedIndex, inc(#seq)
emit/fertilize_committed (#viewerId, #bedIndex, #seq)
end note
