stateDiagram-v2
    [*] --> IDLE
    state canAfford <<choice>>
    IDLE --> canAfford: START_SHOPPING (coins, marketPrices)
    canAfford --> BROWSING: hasCoinsForTrade($coins, $marketPrices)
    canAfford --> IDLE
    BROWSING --> CONFIRM: CHOOSE_SLOT (slotIndex)
    CONFIRM --> BROWSING: CONFIRM_BUY
    CONFIRM --> BROWSING: CANCEL
    BROWSING --> IDLE: END_SHOPPING
    CONFIRM --> IDLE: END_SHOPPING

note right of IDLE
+Init
end note

note right of [*]
define/hasCoinsForTrade (c,p) => and(isPositive(len(p)), isGreaterOrEqual(coalesce(c,0), coalesce(min(p),0)))
#{slotIndex = -1}
subscribe/shopping_phase_started START_SHOPPING ($coins, $marketPrices)
subscribe/market_slot_picked CHOOSE_SLOT ($slotIndex)
subscribe/market_purchase_confirmed CONFIRM_BUY
subscribe/selection_cancelled CANCEL
subscribe/shopping_phase_ended END_SHOPPING
end note

note left of BROWSING
#{slotIndex} <= -1
end note

note left of CONFIRM
#{slotIndex} <= $slotIndex
end note
