stateDiagram-v2
    direction LR
    [*] --> IDLE
    state byKind <<choice>>
    IDLE --> byKind: ENABLE (targetKind)
    TARGETING --> byKind: ENABLE (targetKind)
    byKind --> TARGETING: needsTarget($targetKind)
    byKind --> CLEARED: noTarget($targetKind)
    CLEARED --> IDLE: [-]
    TARGETING --> IDLE: QUIT

note right of IDLE
+Init
end note

note right of CLEARED
+ByPass
end note

note right of [*]
define/needsTarget (k) => not(isEqual(coalesce(k,'none'),'none'))
define/noTarget (k) => isEqual(coalesce(k,'none'),'none')
#{targetKind = 'none'}
subscribe/play_card_picked ENABLE ($targetKind)
subscribe/play_bed_picked ENABLE ($targetKind)
subscribe/play_target_picked QUIT
subscribe/selection_cancelled QUIT
subscribe/play_phase_ended QUIT
end note

note left of TARGETING
#{targetKind} <= $targetKind
end note
