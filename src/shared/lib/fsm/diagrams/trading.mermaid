stateDiagram-v2
    [*] --> IDLE
    state hasCards <<choice>>
    IDLE --> hasCards: START_TRADE (viewerId, hand)
    hasCards --> COLLECT: hasCardsInHand($hand)
    hasCards --> IDLE
    COLLECT --> CARD_ADDED: ADD_CARD (cardId)
    CARD_ADDED --> COLLECT: [-]
    COLLECT --> CARD_REMOVED: REMOVE_CARD (cardId)
    CARD_REMOVED --> COLLECT: [-]
    COLLECT --> OFFERED: SEND_OFFER
    OFFERED --> CHOOSING: BIDS_ARRIVED
    CHOOSING --> ACCEPTED: ACCEPT_BID (bidderId)
    COLLECT --> IDLE: END_TRADE
    OFFERED --> IDLE: END_TRADE
    CHOOSING --> IDLE: END_TRADE
    ACCEPTED --> IDLE: END_TRADE

note right of IDLE
+Init
#{offered} <= emptyMap()
end note

note right of [*]
define/hasCardsInHand (h) => isPositive(len(coalesce(h,[])))
define/emptyMap () => omit(zip([],[]),[])
#{viewerId = 0, offered = emptyMap(), bidderId = 0, seq = 0}
subscribe/trade_phase_started START_TRADE ($viewerId, $hand)
subscribe/trade_card_added ADD_CARD ($cardId)
subscribe/trade_card_removed REMOVE_CARD ($cardId)
subscribe/trade_offer_sent SEND_OFFER
subscribe/trade_bids_gathered BIDS_ARRIVED
subscribe/trade_bid_accepted ACCEPT_BID ($bidderId)
subscribe/turn_phase_ended END_TRADE
subscribe/turn_ended END_TRADE
end note

note left of COLLECT
#{viewerId, offered, bidderId, seq} <= coalesce($viewerId, #viewerId), #offered, #bidderId, #seq
end note

note right of CARD_ADDED
+ByPass
#{viewerId, offered, bidderId, seq} <= #viewerId, setAttr(omit(#offered,[]), $cardId, 1), #bidderId, #seq
end note

note right of CARD_REMOVED
+ByPass
#{viewerId, offered, bidderId, seq} <= #viewerId, omit(#offered, $cardId), #bidderId, #seq
end note

note left of OFFERED
#{viewerId, offered, bidderId, seq} <= #viewerId, #offered, #bidderId, inc(#seq)
emit/trade_offer_committed (#viewerId, #offered, #seq)
end note

note left of CHOOSING
#{viewerId, offered, bidderId, seq} <= #viewerId, #offered, #bidderId, #seq
end note

note right of ACCEPTED
#{viewerId, offered, bidderId, seq} <= #viewerId, #offered, $bidderId, inc(#seq)
emit/trade_accept_committed (#viewerId, #bidderId, #seq)
end note
